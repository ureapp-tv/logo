  <style>
    .app-boot {
      position: fixed;
      inset: 0;
      z-index: 99999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 18px;
      background: #111111;
      color: #fff;
    }
    .app-boot img {
      width: 72px;
      height: 72px;
      object-fit: contain;
    }
    .app-boot-spinner {
      width: 32px;
      height: 32px;
      border: 3px solid rgba(234, 36, 41, 0.22);
      border-top-color: #ea2429;
      border-radius: 50%;
      animation: app-boot-spin 0.7s linear infinite;
    }
    @keyframes app-boot-spin {
      to { transform: rotate(360deg); }
    }
  </style>
